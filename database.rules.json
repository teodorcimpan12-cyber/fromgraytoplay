{
  "rules": {
    ".read": "auth != null && auth.uid === 'IIdfYqliTrdlYqjS0swd0swlRkV2'",
    ".write": "auth != null && auth.uid === 'IIdfYqliTrdlYqjS0swd0swlRkV2'",

    "settings": {
      ".read": true
    },

    "votes": {
      ".read": true,
      "$choice": {
        ".write": "(!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1)",
        ".validate": "newData.isNumber() && newData.val() >= 0 && ($choice === 'flip' || $choice === 'mural' || $choice === 'both')"
      }
    },

    "signups": {
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['name','email','date']) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 100 && newData.child('email').isString() && newData.child('email').val().length <= 120 && newData.child('email').val().matches(/^[^@ ]+@[^@ ]+[.][^@ .][^@ .]+$/)"
      }
    },

    "signupStats": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['date','volunteer']) && newData.child('volunteer').isBoolean()"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "partnerRequests": {
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['email','date'])"
      }
    },

    "activity": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('settings/sherifs/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['type','timestamp']) && newData.child('type').isString() && newData.child('type').val().length <= 50"
      }
    },

    "reports": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('settings/sherifs/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['courtId','description']) && newData.child('description').isString() && newData.child('description').val().length <= 2000"
      }
    },

    "pledges": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('settings/sherifs/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['pledge','ts']) && newData.child('pledge').isString() && newData.child('pledge').val().length <= 80"
      }
    },

    "forum": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('settings/sherifs/' + auth.uid).exists())",
        "upvotes":   { ".write": true, ".validate": "newData.isNumber()" },
        "downvotes": { ".write": true, ".validate": "newData.isNumber()" },
        "replies": {
          "$rid": { ".write": "!data.exists() || (auth != null && root.child('settings/sherifs/' + auth.uid).exists())" }
        }
      }
    },

    "events": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('settings/sherifs/' + auth.uid).exists()",
        "attendeeCount": { ".write": true, ".validate": "newData.isNumber()" }
      }
    },

    "teams": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('settings/sherifs/' + auth.uid).exists())"
      }
    },

    "courts": {
      ".read": true,
      "$courtId": {
        ".write": "!data.exists() || (auth != null && root.child('settings/sherifs/' + auth.uid).exists())",
        "checkins": {
          "$uid": { ".write": true }
        }
      }
    },

    "letterCount": {
      ".read": true,
      "total": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },

    "budgetLive":   { ".read": true },

    "bookings":     { ".read": true, ".write": true },
    "pixels":       { ".read": true, ".write": true },
    "presence":     { ".read": true, ".write": true },
    "achievements": { ".read": true, ".write": true },
    "adoptions":    { ".read": true, ".write": true },
    "tasks":        { ".read": true, ".write": true },
    "leaderboard":  { ".read": true, ".write": true },
    "games":        { ".read": true, ".write": true },
    "gallery":      { ".read": true, ".write": true },
    "ratings":      { ".read": true, ".write": true },
    "follows":      { ".read": true, ".write": true }
  }
}
