{
  "rules": {
    ".read": false,
    ".write": false,

    "settings": {
      ".read": "auth != null && auth.uid === 'IIdfYqliTrdlYqjS0swd0swlRkV2'",
      ".write": "auth != null && auth.uid === 'IIdfYqliTrdlYqjS0swd0swlRkV2'"
    },

    "signups": {
      ".read": "auth != null && auth.uid === 'IIdfYqliTrdlYqjS0swd0swlRkV2'",
      "$uid": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['email','name']) && newData.child('email').isString() && newData.child('email').val().length <= 100 && newData.child('name').isString() && newData.child('name').val().length <= 100"
      }
    },

    "votes": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isNumber()"
    },

    "reports": {
      ".read": "auth != null && auth.uid === 'IIdfYqliTrdlYqjS0swd0swlRkV2'",
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['court','text','ts']) && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('court').isString() && newData.child('court').val().length <= 20 && (!newData.hasChild('city') || newData.child('city').isString() && (newData.child('city').val() === 'tgm' || newData.child('city').val() === 'sibiu'))"
      }
    },

    "pixels": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['color']) && newData.child('color').isString() && newData.child('color').val().matches(/^#[0-9a-fA-F]{6}$/)"
      }
    },

    "activity": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['type','ts']) && newData.child('type').isString() && newData.child('type').val().length <= 50 && (!newData.hasChild('city') || newData.child('city').isString() && (newData.child('city').val() === 'tgm' || newData.child('city').val() === 'sibiu'))"
      }
    },

    "pledges": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['text','ts']) && newData.child('text').isString() && newData.child('text').val().length <= 500"
      }
    },

    "courts": {
      ".read": true,
      "$courtId": {
        "checkins": {
          "$id": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['ts']) && (!newData.hasChild('city') || newData.child('city').isString() && (newData.child('city').val() === 'tgm' || newData.child('city').val() === 'sibiu'))"
          }
        }
      }
    },

    "bookings": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['court','ts']) && newData.child('court').isString() && newData.child('court').val().length <= 20 && (!newData.hasChild('city') || newData.child('city').isString() && (newData.child('city').val() === 'tgm' || newData.child('city').val() === 'sibiu'))"
      }
    },

    "presence": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['ts'])"
      }
    },

    "achievements": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['type','ts']) && newData.child('type').isString() && newData.child('type').val().length <= 50"
      }
    },

    "users": {
      ".read": "auth != null && auth.uid === 'IIdfYqliTrdlYqjS0swd0swlRkV2'",
      "$uid": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['email','name'])"
      }
    },

    "leaderboard": {
      ".read": true,
      "$uid": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['name','points'])"
      }
    }
  }
}
